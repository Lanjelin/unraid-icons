<?xml version="1.0"?>
<PLUGIN name="unraid-icons" author="Lanjelin" version="2026.10.21" launch="Settings/Icons" icon="unraid-icons.png" pluginURL="https://raw.githubusercontent.com/lanjelin/unraid-icons/main/dist/unraid-icons.plg" support="https://github.com/lanjelin/unraid-icons/issues">
<CHANGES><![CDATA[
### 2026.10.21
- Added: Import base64-encoded PNG data URLs through Custom URL.
- Added: Optional Compose Manager Plus stack and service icon pickers, saving independent PNG copies.
- Added: Optional FolderView3 Docker and VM folder icon pickers, saving independent PNG copies.
- Changed: Derive the plugin version from the newest changelog heading during builds.

### 2026.10.19j
- Initial release.

]]></CHANGES>
<FILE Name="/tmp/unraid-icons-install.sh" Run="/bin/bash"><INLINE><![CDATA[
#!/bin/bash
set -euo pipefail
trap 'rm -f /tmp/unraid-icons-install.sh /tmp/unraid-icons-payload.tgz' EXIT
php -r 'foreach (["curl", "gd", "dom", "simplexml"] as $extension) { if (!extension_loaded($extension)) { fwrite(STDERR, "unraid-icons requires PHP extension: $extension\n"); exit(1); } }'
